{
  "model": "MMGCN",
  "dataset": "Clothing",
  "seeds": [
    2022,
    2023,
    2024,
    2025,
    2026
  ],
  "training_hyperparameters": {
    "aggr_mode": "mean",
    "batch_size": 1024,
    "cold_candidates": "all",
    "concatenate": false,
    "core": "5",
    "embedding_dim": 64,
    "eval_batch_size": 256,
    "eval_every": 5,
    "layers": 4,
    "lr": 0.001,
    "max_epochs": 1000,
    "min_delta": 0.0,
    "modalities": "auto",
    "monitor_split": "test",
    "no_id": false,
    "patience": 5,
    "reg_weight": 0.0001,
    "selection_metric": "NDCG@20",
    "visual_dim": 256
  }
}
