{
  "model": "EgoGCN",
  "dataset": "Sports",
  "seeds": [
    2022,
    2023,
    2024,
    2025,
    2026
  ],
  "training_hyperparameters": {
    "alpha_threshold": 0.6,
    "batch_size": 1024,
    "cold_candidates": "all",
    "core": "5",
    "embedding_dim": 64,
    "eval_batch_size": 256,
    "eval_every": 5,
    "fusion_mode": "mean",
    "lr": 0.001,
    "max_epochs": 200,
    "min_delta": 0.0,
    "modalities": "auto",
    "modulation": "hard",
    "monitor_split": "test",
    "no_reattention": false,
    "num_routing": 1,
    "patience": 5,
    "reg_weight": 0.0001,
    "selection_metric": "NDCG@20"
  }
}
