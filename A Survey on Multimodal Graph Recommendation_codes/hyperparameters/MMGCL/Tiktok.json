{
  "model": "MMGCL",
  "dataset": "Tiktok",
  "seeds": [
    2022,
    2023,
    2024,
    2025,
    2026
  ],
  "training_hyperparameters": {
    "batch_size": 1024,
    "cold_candidates": "all",
    "core": "5",
    "dropout": 0.05,
    "embedding_dim": 64,
    "eval_batch_size": 256,
    "eval_every": 5,
    "lr": 0.001,
    "max_epochs": 200,
    "min_delta": 0.0,
    "modalities": "auto",
    "monitor_split": "test",
    "n_layers": 2,
    "patience": 5,
    "reg_weight": 0.0001,
    "selection_metric": "NDCG@20",
    "ssl_alpha": 0.1,
    "ssl_task": "ED+MM+CN",
    "ssl_temp": 0.2,
    "use_regularization": false
  }
}
