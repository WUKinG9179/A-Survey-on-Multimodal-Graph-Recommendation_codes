{
  "model": "SiMGR",
  "dataset": "Sports",
  "seeds": [
    2022,
    2023,
    2024,
    2025,
    2026
  ],
  "training_hyperparameters": {
    "batch_size": 1024,
    "cold_candidates": "all",
    "core": "5",
    "embedding_dim": 64,
    "eval_batch_size": 256,
    "eval_every": 5,
    "graph_block_size": 256,
    "ii_topk": 10,
    "lr": 0.001,
    "max_epochs": 200,
    "min_delta": 0.0,
    "modalities": "auto",
    "monitor_split": "test",
    "n_layers": 2,
    "patience": 5,
    "pseudo_candidates": 64,
    "pseudo_per_user": 1,
    "ratings_file": null,
    "reg_weight": 0.0001,
    "selection_metric": "NDCG@20",
    "sign_weight": 0.1,
    "ssl_alpha": 0.01,
    "ssl_temp": 0.2,
    "threshold_std": 0.0
  },
  "implementation_variant": "SiMGR-Implicit"
}
