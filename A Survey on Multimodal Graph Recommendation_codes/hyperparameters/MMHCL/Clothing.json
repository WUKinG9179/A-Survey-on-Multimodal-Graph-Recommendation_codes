{
  "model": "MMHCL",
  "dataset": "Clothing",
  "seeds": [
    2022,
    2023,
    2024,
    2025,
    2026
  ],
  "training_hyperparameters": {
    "batch_size": 1024,
    "cf_model": "LightGCN",
    "cold_candidates": "all",
    "core": "5",
    "embedding_dim": 64,
    "eval_batch_size": 256,
    "eval_every": 5,
    "graph_block_size": 256,
    "item_layers": 2,
    "item_loss_ratio": 0.7,
    "lr": 0.001,
    "max_epochs": 200,
    "min_delta": 0.0,
    "modalities": "auto",
    "monitor_split": "test",
    "patience": 5,
    "reg_weight": 0.0001,
    "selection_metric": "NDCG@20",
    "ssl_chunk_size": 128,
    "temperature": 0.6,
    "topk": 5,
    "ui_layers": 2,
    "user_layers": 3,
    "user_loss_ratio": 0.3
  }
}
